{
  "manifest_version": 3,
  "name": "Extratus",
  "version": "0.0.1",
  "description": "Exporta extratos OFX/CSV de bancos e fintechs brasileiros direto do navegador",
  "permissions": ["downloads", "tabs"],
  "host_permissions": ["https://*.mercadopago.com.br/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Extratus"
  }
}
