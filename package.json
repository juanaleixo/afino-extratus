{
  "name": "afino-extratus",
  "version": "0.0.1",
  "private": true,
  "description": "Browser extension that exports OFX and CSV statements from Brazilian bank and fintech sites in the Afino flow",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:hmr": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "decimal.js": "^10.4.3",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.270",
    "happy-dom": "^15.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
